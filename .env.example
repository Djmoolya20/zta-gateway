# ZTA Gateway — SMTP Configuration for Email Verification
# Copy this file to .env and fill in your values.
# The .env file is gitignored and will NOT be committed.

# REQUIRED for real SMTP delivery (otherwise falls back to console/LAB MODE)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=ZTA Gateway <noreply@yourdomain.com>

# Notes:
# - Gmail: Use an App Password (not your regular password). Enable 2FA first,
#   then generate at https://myaccount.google.com/apppasswords
# - Outlook/Office365: May require App Password or have security defaults blocking SMTP.
# - Port 587 with MAIL_USE_TLS=true = STARTTLS (most common)
# - Port 465 with MAIL_USE_SSL=true = implicit SSL (legacy)
# - Do NOT set both MAIL_USE_TLS and MAIL_USE_SSL to true.
# - MAIL_DEFAULT_SENDER: The "From" address shown in emails. Use a real address
#   from your domain for best deliverability.

# --- Email warning feature (Phase 10) ---
# ZTA_NOTIFY=1
# ZTA_NOTIFY_COOLDOWN_MINUTES=10
# ZTA_NOTIFY_MIN_WINDOWS=1
# ZTA_NOTIFY_BAN_NOTICE=1
# Optional: copy the administrator on every notice.
# ZTA_NOTIFY_ADMIN_COPY=